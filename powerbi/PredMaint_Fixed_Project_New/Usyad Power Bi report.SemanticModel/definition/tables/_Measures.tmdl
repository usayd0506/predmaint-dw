	measure 'Rule Hits' = ```
			
			VAR RuleId = SELECTEDVALUE ( RuleCatalog[rule_id] )
			RETURN
			IF (
			    ISBLANK ( RuleId ),
			    BLANK (),
			    CALCULATE (
			        COUNTROWS ( FactAlert ),
			        FILTER (
			            FactAlert,
			            CONTAINSSTRING (
			                "," & SUBSTITUTE ( FactAlert[rules_fired], " ", "" ) & ",",
			                "," & RuleId & ","
			            )
			        )
			    )
			)
			
			```
		formatString: 0
		displayFolder: 04 Alerts
		lineageTag: a24ebea3-407a-4037-941f-13877edd09aa

