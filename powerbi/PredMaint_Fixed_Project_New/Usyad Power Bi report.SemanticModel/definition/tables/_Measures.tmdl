	measure 'Technician Utilization %' = ```
			
			VAR ScheduledHrs =
			    CALCULATE (
			        [Scheduled Hours],
			        DimMethod[method_name] = "GA"
			    )
			VAR CapacityPerWeek =
			    SUMX (
			        ALL ( DimTechnician ),
			        DimTechnician[max_hours_per_week]
			    )
			VAR MinSlot =
			    CALCULATE (
			        MIN ( FactSchedule[slot_start] ),
			        DimMethod[method_name] = "GA"
			    )
			VAR MaxSlot =
			    CALCULATE (
			        MAX ( FactSchedule[slot_start] ),
			        DimMethod[method_name] = "GA"
			    )
			VAR DaySpan =
			    IF (
			        ISBLANK ( MinSlot ) || ISBLANK ( MaxSlot ),
			        BLANK (),
			        DATEDIFF ( MinSlot, MaxSlot, DAY )
			    )
			VAR WeekCount =
			    IF ( ISBLANK ( DaySpan ), BLANK (), MAX ( 1, INT ( DIVIDE ( DaySpan, 7 ) ) + 1 ) )
			RETURN
			DIVIDE ( ScheduledHrs, CapacityPerWeek * WeekCount, 0 )
			
			```
		formatString: 0.00%
		displayFolder: 06 Scheduling
		lineageTag: 366c0096-ef41-4014-a869-4deb2f9f7f0b

