		lineageTag: d22efcb7-a339-4902-a4da-98aebd265611

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Days Since Maintenance' =
			
			AVERAGEX(
			    FILTER(
			        FactEngineHealth,
			        NOT ISBLANK(FactEngineHealth[last_maintenance])
			    ),
			    VAR SnapshotDate =
			        LOOKUPVALUE(
			            DimDate[full_date],
			            DimDate[date_key],
			            FactEngineHealth[date_key]
			        )
			    RETURN
			        IF(
			            NOT ISBLANK(SnapshotDate) &&
			            SnapshotDate >= FactEngineHealth[last_maintenance],
			            DATEDIFF(
			                FactEngineHealth[last_maintenance],
			                SnapshotDate,
			                DAY
			            )
			        )
			)
		lineageTag: 0187f1d5-b877-42b5-bcf1-aa9d3404f183

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Engines Never Maintained' =
			
			CALCULATE(
			    DISTINCTCOUNT(FactEngineHealth[engine_key]),
			    ISBLANK(FactEngineHealth[last_maintenance])
			)
		formatString: 0
		lineageTag: 94a9f980-45e0-447f-b98d-3164a1a05eb1

	measure 'Avg Predicted RUL' = ```
			
			VAR FilteredML =
			    CALCULATETABLE (
			        VALUES ( DimModel[model_name] ),
			        DimModel[model_name] IN { "XGBoost", "LinearRegression" }
			    )
			VAR ModelCount = COUNTROWS ( FilteredML )
			VAR UseModel =
			    IF (
			        ModelCount = 0,
			        BLANK (),
			        IF (
			            ModelCount = 1,
			            MAXX ( FilteredML, DimModel[model_name] ),
			            "XGBoost"
			        )
			    )
			RETURN
			IF (
			    ISBLANK ( UseModel ),
			    BLANK (),
			
			CALCULATE (
			    AVERAGE ( FactRULPrediction[predicted_rul] ),
			    DimModel[model_name] = UseModel
			)
			)
			
			```
		formatString: #,0.0
		displayFolder: 03 Watchlist
		lineageTag: 8a8dccb5-ac4b-4a5e-b4f4-4b26ae919a88

