	column 'Health Index Bin' =
			
			VAR H = FactEngineHealth[health_index]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(H), BLANK(),
			        H < 20, "00–19",
			        H < 40, "20–39",
			        H < 60, "40–59",
			        H < 80, "60–79",
			        "80–100"
			    )
		lineageTag: 528ec035-e48e-4184-b92a-0b60fd394cde
		summarizeBy: none
		sortByColumn: 'Health Index Bin Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Health Index Bin Sort' =
			
			VAR H = FactEngineHealth[health_index]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(H), BLANK(),
			        H < 20, 1,
			        H < 40, 2,
			        H < 60, 3,
			        H < 80, 4,
			        5
			    )
		formatString: 0
		lineageTag: a522b7f0-f48f-4786-bbcf-472f819fec95
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

