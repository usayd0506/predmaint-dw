	partition DimDate = m
		mode: import
		source =
				let
				    Source = Sql.Database("USAYD-PC\SQLEXPRESS", "PredMaintDW"),
				    Data = Source{[Schema="mart", Item="DimDate"]}[Data],
				    #"Removed Navigation" = Table.RemoveColumns(
				        Data,
				        List.Select(
				            Table.ColumnNames(Data),
				            each Text.StartsWith(_, "mart.")
				        )
				    ),
				    #"Changed Type" = Table.TransformColumnTypes(
				        #"Removed Navigation",
				        {{"full_date", type date}}
				    ),
				    #"Added Year Month" = Table.AddColumn(
				        #"Changed Type",
				        "year_month",
				        each Date.ToText([full_date], "yyyy-MM"),
				        type text
				    ),
				    #"Added Weekday Name" = Table.AddColumn(
				        #"Added Year Month",
				        "weekday_name",
				        each Date.DayOfWeekName([full_date], "en-US"),
				        type text
				    )
				in
				    #"Added Weekday Name"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

